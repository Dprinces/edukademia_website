# Copy to .env.local (local) or set in your hosting provider's environment settings.

# Google Apps Script web app URL. Saves every website form to a Google Sheet and emails
# each submission to Edukademia. See integrations/google-sheets/README.md for setup.
VITE_FORMS_SHEET_URL=

# Web3Forms access key (free at web3forms.com, created for edukademia1@gmail.com).
# Emails every form submission to that inbox. Safe to use in the website.
VITE_WEB3FORMS_KEY=

# Optional: replace the built-in Google Calendar booking page (e.g. with Calendly or Cal.com).
VITE_BOOKING_URL=

# Set to "true" once the backend is deployed, to send every form to the API instead.
VITE_USE_API=false
